# ===== 应用配置 =====
APP_PORT=3000
APP_PREFIX=api
NODE_ENV=development

# ===== 数据库配置 (PostgreSQL) =====
DB_HOST=localhost
DB_PORT=5432
DB_USERNAME=postgres
DB_PASSWORD=postgres
DB_DATABASE=x_auto
DB_SYNC=true
DB_LOGGING=false

# ===== JWT 配置 =====
JWT_SECRET=your_super_secret_change_me_in_production
JWT_EXPIRES_IN=7d

# ===== 前端 CORS =====
CORS_ORIGIN=http://localhost:5173
