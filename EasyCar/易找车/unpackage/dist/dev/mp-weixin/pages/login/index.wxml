<view class="app-container"><view class="header"><text class="header-title">欢迎使用</text><text class="header-subtitle">找到车了么</text></view><view class="tab-container"><view data-event-opts="{{[['tap',[['switchTab',[0]]]]]}}" class="{{['tab-item',(currentTab===0)?'active':'']}}" bindtap="__e"><text class="tab-text">登录</text></view><view data-event-opts="{{[['tap',[['switchTab',[1]]]]]}}" class="{{['tab-item',(currentTab===1)?'active':'']}}" bindtap="__e"><text class="tab-text">注册</text></view></view><block wx:if="{{currentTab===0}}"><view class="form-container"><view class="input-group"><input class="form-input" placeholder="请输入用户名" data-event-opts="{{[['input',[['__set_model',['$0','username','$event',[]],['loginForm']]]]]}}" value="{{loginForm.username}}" bindinput="__e"/></view><view class="input-group"><input class="form-input" password="{{true}}" placeholder="请输入密码" data-event-opts="{{[['input',[['__set_model',['$0','password','$event',[]],['loginForm']]]]]}}" value="{{loginForm.password}}" bindinput="__e"/></view><view data-event-opts="{{[['tap',[['handleLogin',['$event']]]]]}}" class="submit-btn" bindtap="__e"><text class="submit-text">登录</text></view></view></block><block wx:if="{{currentTab===1}}"><view class="form-container"><view class="input-group"><input class="form-input" placeholder="请输入用户名" data-event-opts="{{[['input',[['__set_model',['$0','username','$event',[]],['registerForm']]]]]}}" value="{{registerForm.username}}" bindinput="__e"/></view><view class="input-group"><input class="form-input" password="{{true}}" placeholder="请输入密码" data-event-opts="{{[['input',[['__set_model',['$0','password','$event',[]],['registerForm']]]]]}}" value="{{registerForm.password}}" bindinput="__e"/></view><view class="input-group"><input class="form-input" password="{{true}}" placeholder="请再次输入密码" data-event-opts="{{[['input',[['__set_model',['$0','confirmPassword','$event',[]],['registerForm']]]]]}}" value="{{registerForm.confirmPassword}}" bindinput="__e"/></view><view data-event-opts="{{[['tap',[['handleRegister',['$event']]]]]}}" class="submit-btn" bindtap="__e"><text class="submit-text">注册</text></view></view></block></view>