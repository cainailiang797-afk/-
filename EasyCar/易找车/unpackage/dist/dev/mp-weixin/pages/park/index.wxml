<view class="app-container"><view class="content"><view class="card"><view class="form-item"><text class="form-label">车位号</text><view class="input-container"><input class="form-input" placeholder="请输入车位号，如：A区-123号" data-event-opts="{{[['input',[['__set_model',['','parkingLocation','$event',[]]]]]]}}" value="{{parkingLocation}}" bindinput="__e"/></view></view><view class="form-item"><text class="form-label">车辆照片（最多2张）</text><view class="upload-container"><block wx:if="{{$root.g0<2}}"><view data-event-opts="{{[['tap',[['chooseImage',['$event']]]]]}}" class="upload-button" bindtap="__e"><text class="upload-icon">+</text><text class="upload-text">上传照片</text></view></block><block wx:for="{{imageUrls}}" wx:for-item="url" wx:for-index="index" wx:key="index"><view class="image-preview"><image class="preview-image" src="{{url}}" mode="aspectFill" data-event-opts="{{[['tap',[['previewImage',['$0'],[[['imageUrls','',index]]]]]]]}}" bindtap="__e"></image><text data-event-opts="{{[['tap',[['deleteImage',[index]]]]]}}" class="delete-image" bindtap="__e">×</text></view></block></view></view><view class="form-item"><text class="form-label">停车位置</text><view class="location-container"><block wx:if="{{!location}}"><view data-event-opts="{{[['tap',[['getLocation',['$event']]]]]}}" class="location-button" bindtap="__e"><text class="location-icon">📍</text><text class="location-text">点击定位当前位置</text></view></block><block wx:else><view class="location-info"><text class="location-icon">📍</text><text class="location-detail">{{location}}</text><text data-event-opts="{{[['tap',[['getLocation',['$event']]]]]}}" class="location-refresh" bindtap="__e">↻</text></view></block></view><block wx:if="{{location}}"><view class="location-map"><map style="width:100%;height:200rpx;" latitude="{{latitude}}" longitude="{{longitude}}" markers="{{$root.m0}}" show-location="{{true}}"></map></view></block></view><view class="submit-container"><view data-event-opts="{{[['tap',[['submitForm',['$event']]]]]}}" class="submit-button" bindtap="__e"><text class="submit-text">提交</text></view></view></view></view></view>