<view class="app-container"><view class="content"><block wx:if="{{loading}}"><view class="loading-container"><text class="loading-text">加载中...</text></view></block><block wx:else><block wx:if="{{$root.g0===0}}"><view class="empty-container"><text class="empty-text">暂无停车记录</text></view></block><block wx:else><view class="list-container"><block wx:for="{{$root.l0}}" wx:for-item="item" wx:for-index="index" wx:key="index"><view class="parking-item-container"><view class="parking-item"><view data-event-opts="{{[['tap',[['previewImage',['$0'],[[['currentPageList','',index,'photo']]]]]]]}}" class="item-image" catchtap="__e"><image src="{{item.$orig.photo}}" mode="aspectFill"></image><view class="image-overlay"><text class="overlay-icon">👁️</text></view></view><view class="item-content"><view class="item-header"><text class="item-location">{{item.$orig.location}}</text></view><view class="item-row"><text class="item-date">{{item.m0+" "+item.m1}}</text></view></view></view><block wx:if="{{item.m2}}"><view data-event-opts="{{[['tap',[['openNavigation',['$0'],[[['currentPageList','',index]]]]]]]}}" class="item-map" bindtap="__e"><map style="width:100%;height:100%;" latitude="{{item.m3}}" longitude="{{item.m4}}" markers="{{item.m5}}" show-location="{{true}}"></map><view class="map-nav-overlay"><text class="map-nav-icon">🧭</text><text class="map-nav-text">导航</text></view></view></block></view></block></view></block></block><block wx:if="{{$root.g1>0}}"><view class="pagination"><view data-event-opts="{{[['tap',[['prevPage',['$event']]]]]}}" class="{{['page-btn',(currentPage===1)?'disabled':'']}}" bindtap="__e"><text class="page-btn-text">上一页</text></view><view class="page-info"><text class="page-num">{{currentPage}}</text><text class="page-total">{{"/ "+totalPages}}</text></view><view data-event-opts="{{[['tap',[['nextPage',['$event']]]]]}}" class="{{['page-btn',(currentPage===totalPages)?'disabled':'']}}" bindtap="__e"><text class="page-btn-text">下一页</text></view></view></block></view></view>